# Database
DATABASE_URL=postgresql+asyncpg://syltalky:syltalky@localhost:5432/syltalky
POSTGRES_USER=syltalky
POSTGRES_PASSWORD=syltalky
POSTGRES_DB=syltalky

# JWT
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=syltalky
MINIO_ROOT_PASSWORD=syltalky123
MINIO_BUCKET=syltalky
MINIO_SECURE=false

# Resend (email)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=noreply@syltalky.app

# LiveKit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# AI API
AI_API_URL=http://localhost:8000

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# App
FRONTEND_URL=http://localhost:5173
